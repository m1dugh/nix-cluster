{ inputs, pkgs, ... }:
let
  net = import ../lib.nix;
in
{
  imports = [
    ../../modules/loadbalancer/haproxy.nix
  ];

  networking.hostName = "cluster-router";

  system.stateVersion = "24.11";

  nix = {
    settings.experimental-features = [
      "nix-command"
      "flakes"
    ];
    registry.nixpkgs.flake = inputs.nixpkgs;
  };

  services.openssh = {
    enable = true;
    settings.PermitRootLogin = "prohibit-password";
  };

  users.users.root.openssh.authorizedKeys.keys = [
    "ssh-rsa  midugh@midugh-arch"
  ];

  environment.systemPackages = with pkgs; [
    vim
    htop
    tcpdump
  ];

  networking.nameservers = [
    "1.1.1.1"
    "8.8.8.8"
  ];

  boot.kernel.sysctl = {
    "net.ipv4.ip_forward" = 1;
    "net.ipv6.conf.all.forwarding" = 1;
  };

  networking = {
    useDHCP = false;

    vlans = {
      "vlan-wan" = {
        id = net.vlans.wan.id;
        interface = "eth0";
      };
      "vlan-infra" = {
        id = net.vlans.infra.id;
        interface = "eth0";
      };
    };

    interfaces = {
      eth0.useDHCP = false;

      vlan-wan = {
        useDHCP = false;
        ipv4 = {
          addresses = [
            {
              address = net.hosts.cluster-router.wan;
              prefixLength = 24;
            }
          ];
          routes = [
            {
              address = "0.0.0.0";
              prefixLength = 0;
              via = net.vlans.wan.gateway;
            }
          ];
        };
      };

      vlan-infra = {
        useDHCP = false;
        ipv4.addresses = [
          {
            address = net.hosts.cluster-router.infra;
            prefixLength = 24;
          }
        ];
      };
    };

    # Fully hand-managed on the host, not generated by Nix: create/edit
    # /etc/wireguard/wg0.conf directly with the real keys and peers
    # ([Interface]/[Peer] wg-quick format), then `systemctl restart wg-quick-wg0`.
    wg-quick.interfaces.wg0 = {
      configFile = "/etc/wireguard/wg0.conf";
    };

    nftables = {
      enable = true;

      ruleset = ''
        table inet filter {
          chain input {
            type filter hook input priority 0; policy drop;

            iifname "lo" accept
            ct state established,related accept
            ct state invalid drop

            iifname "vlan-infra" accept
            iifname "vlan-wan" icmp type echo-request accept
            iifname "vlan-wan" icmpv6 type echo-request accept
            iifname "vlan-wan" tcp dport 22 accept
            iifname "vlan-wan" udp dport 51820 accept
          }

          chain forward {
            type filter hook forward priority 0; policy drop;

            ct state established,related accept
            iifname "vlan-infra" oifname "vlan-wan" accept
          }

          chain output {
            type filter hook output priority 0; policy accept;
          }
        }
      '';
    };
  };

  services.kea.dhcp4 = {
    enable = true;
    settings = {
      interfaces-config.interfaces = [ "vlan-infra" ];
      lease-database = {
        type = "memfile";
        persist = true;
        name = "/var/lib/kea/dhcp4.leases";
      };

      subnet4 = [
        {
          subnet = net.vlans.infra.cidr;
          pools = [ { pool = "192.168.2.100 - 192.168.2.200"; } ];
          option-data = [
            {
              name = "routers";
              data = net.hosts.cluster-router.infra;
            }
            {
              name = "domain-name-servers";
              data = net.hosts.cluster-router.infra;
            }
          ];

          # netboot: point PXE clients at the TFTP server on this host
          next-server = net.hosts.cluster-router.infra;
          boot-file-name = "pxelinux.0";
        }
      ];
    };
  };

  # Serves Talos netboot images (kernel + initramfs) to the infra vlan.
  # Images are expected to be dropped under /var/lib/tftpboot by a separate
  # provisioning step (not yet implemented).
  services.tftpd = {
    enable = true;
    path = "/var/lib/tftpboot";
  };

  services.nginx = {
    enable = true;
    virtualHosts."netboot.infra" = {
      listen = [
        {
          addr = net.hosts.cluster-router.infra;
          port = 8080;
        }
      ];
      root = "/var/lib/tftpboot";
    };
  };

  services.cluster.haproxy = {
    enable = true;
    interface = "vlan-infra";
    nodes = [
      net.hosts.cluster-master-1.infra
      net.hosts.cluster-worker-1.infra
      net.hosts.cluster-worker-2.infra
    ];
    ports = [
      {
        remotePort = 6443;
        localPort = 6443;
      }
    ];
  };
}
